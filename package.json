		"@oslojs/encoding": "^1.1.0",
		"@resvg/resvg-js": "^2.6.2",
		"@turf/turf": "^7.4.0",
		"better-auth": "1.6.30",
		"bits-ui": "^2.19.0",
		"chalk": "^6.0.0",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
